{
  "name": "verihook",
  "version": "1.11.0",
  "description": "Universal typed webhook verifier for Stripe, GitHub, Shopify, Slack, Twilio, Svix, Meta, WhatsApp, Discord, Twitter, PayPal, LemonSqueezy, Paddle, PagerDuty, Webflow, WorkOS, Linear, Razorpay, Cashfree, PhonePe, Mollie, Adyen, Checkout.com, Authorize.net, Recurly, Zoom, and custom providers.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.mjs",
      "require": "./dist/express.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.mjs",
      "require": "./dist/next.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.mjs",
      "require": "./dist/testing.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.mjs",
      "require": "./dist/fastify.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.mjs",
      "require": "./dist/hono.js"
    },
    "./h3": {
      "types": "./dist/h3.d.ts",
      "import": "./dist/h3.mjs",
      "require": "./dist/h3.js"
    },
    "./sveltekit": {
      "types": "./dist/sveltekit.d.ts",
      "import": "./dist/sveltekit.mjs",
      "require": "./dist/sveltekit.js"
    },
    "./remix": {
      "types": "./dist/remix.d.ts",
      "import": "./dist/remix.mjs",
      "require": "./dist/remix.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.mjs",
      "require": "./dist/astro.js"
    },
    "./lambda": {
      "types": "./dist/lambda.d.ts",
      "import": "./dist/lambda.mjs",
      "require": "./dist/lambda.js"
    },
    "./nestjs": {
      "types": "./dist/nestjs.d.ts",
      "import": "./dist/nestjs.mjs",
      "require": "./dist/nestjs.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "verihook": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:regression": "vitest run tests/regression.test.ts",
    "test:all": "bash scripts/test-all.sh",
    "typecheck": "tsc --noEmit && tsc -p tests/types/tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run format:check && npm run typecheck && npm run test:coverage && npm run build",
    "pre-commit": "bash scripts/pre-commit.sh",
    "pre-release": "bash scripts/pre-release.sh",
    "prepublishOnly": "npm run test:all"
  },
  "keywords": [
    "webhook",
    "verify",
    "verifier",
    "signature",
    "stripe",
    "github",
    "shopify",
    "slack",
    "twilio",
    "svix",
    "resend",
    "clerk",
    "meta",
    "whatsapp",
    "facebook",
    "instagram",
    "discord",
    "linear",
    "razorpay",
    "cashfree",
    "phonepe",
    "mollie",
    "adyen",
    "checkout.com",
    "authorize.net",
    "recurly",
    "zoom",
    "square",
    "hmac",
    "ed25519",
    "security",
    "typescript",
    "fastify",
    "hono",
    "nuxt",
    "h3",
    "sveltekit",
    "remix",
    "react-router",
    "astro",
    "aws-lambda",
    "nestjs",
    "express",
    "nextjs"
  ],
  "author": "Piyush Anand",
  "license": "MIT",
  "homepage": "https://github.com/creatorpiyush/verihook#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/creatorpiyush/verihook.git"
  },
  "bugs": {
    "url": "https://github.com/creatorpiyush/verihook/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "4.1.10",
    "fastify": "5.12.5",
    "h3": "1.15.11",
    "hono": "4.13.12",
    "prettier": "3.9.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
