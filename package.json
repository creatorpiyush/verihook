{
  "name": "verihook",
  "version": "1.2.0",
  "description": "Universal typed webhook verifier for Stripe, GitHub, Shopify, Slack, Twilio, Svix, Meta, WhatsApp, Discord, Twitter, PayPal, LemonSqueezy, Paddle, PagerDuty, Webflow, WorkOS, Linear, Razorpay, Zoom, and custom providers.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "verihook": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test && npm run build",
    "pre-commit": "bash scripts/pre-commit.sh",
    "pre-release": "bash scripts/pre-release.sh",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "webhook",
    "verify",
    "verifier",
    "signature",
    "stripe",
    "github",
    "shopify",
    "slack",
    "twilio",
    "svix",
    "resend",
    "clerk",
    "meta",
    "whatsapp",
    "facebook",
    "instagram",
    "discord",
    "linear",
    "razorpay",
    "zoom",
    "square",
    "hmac",
    "ed25519",
    "security",
    "typescript"
  ],
  "author": "Piyush Anand",
  "license": "MIT",
  "homepage": "https://github.com/creatorpiyush/verihook#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/creatorpiyush/verihook.git"
  },
  "bugs": {
    "url": "https://github.com/creatorpiyush/verihook/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}