{
  "name": "verihook",
  "version": "1.5.0",
  "description": "Universal typed webhook verifier for Stripe, GitHub, Shopify, Slack, Twilio, Svix, Meta, WhatsApp, Discord, Twitter, PayPal, LemonSqueezy, Paddle, PagerDuty, Webflow, WorkOS, Linear, Razorpay, Zoom, and custom providers.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.mjs",
      "require": "./dist/express.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.mjs",
      "require": "./dist/next.js"
    }
  },
  "bin": {
    "verihook": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:regression": "vitest run tests/regression.test.ts",
    "test:all": "bash scripts/test-all.sh",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run format:check && npm run typecheck && npm run test:coverage && npm run build",
    "pre-commit": "bash scripts/pre-commit.sh",
    "pre-release": "bash scripts/pre-release.sh",
    "prepublishOnly": "npm run format:check && npm run typecheck && npm run test:coverage && npm run build"
  },
  "keywords": [
    "webhook",
    "verify",
    "verifier",
    "signature",
    "stripe",
    "github",
    "shopify",
    "slack",
    "twilio",
    "svix",
    "resend",
    "clerk",
    "meta",
    "whatsapp",
    "facebook",
    "instagram",
    "discord",
    "linear",
    "razorpay",
    "zoom",
    "square",
    "hmac",
    "ed25519",
    "security",
    "typescript"
  ],
  "author": "Piyush Anand",
  "license": "MIT",
  "homepage": "https://github.com/creatorpiyush/verihook#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/creatorpiyush/verihook.git"
  },
  "bugs": {
    "url": "https://github.com/creatorpiyush/verihook/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "4.1.10",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}